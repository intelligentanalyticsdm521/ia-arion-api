  "checks": {
    "no_price": "Put a price in anything I write. Prices come from your price list, never from me.",
    "offers_from_brief_only": "Offer a discount or anything free that isn't in the offers you allow.",
    "no_invented_proof": "Quote a customer, a number or an award that isn't in the proof you allow.",
    "no_names_from_never_name": "Name anyone on your list of names never to mention.",
    "no_competitor_names": "Name a competitor.",
    "no_ranking_promise": "Promise a place on Google.",
    "low_star_review_asks": "Answer a review of 3 stars or fewer without you.",
    "hold_complaint_legal_refund": "Answer a complaint, a refund or anything legal without you.",
    "over_money_limit_asks": "Send a quote over your limit without you.",
    "no_collections_language": "Threaten, say 'final notice', or use legal words about money."
  },
  "price_re": {
    "source": "(\\$|£|€)\\s?\\d|\\b\\d[\\d,.]*\\s?(dollars|usd|bucks)\\b|\\b(costs?|price is|priced at|starts? at)\\s+\\$?\\d",
    "flags": "i"
  },
  "person_re": {
    "source": "\\b(?:[Ii] am|[Ii]'m|[Ii]’m|[Tt]his is|[Mm]y name is)\\s+(?!ARGUS\\b)[A-Z][a-z]+\\b",
    "flags": ""
  },
  "offer_patterns": [
    {
      "source": "\\b\\d{1,3}\\s?(?:%|percent)\\s*off\\b",
      "flags": "i"
    },
    {
      "source": "(?<![\\w-])free\\s+(?!(?:to|up|time|from|and|or)\\b)[\\w][\\w-]*",
      "flags": "i"
    },
    {
      "source": "\\b(?:discount(?:s|ed)?|coupons?|promo codes?|vouchers?)\\b",
      "flags": "i"
    },
    {
      "source": "\\bsave\\s+(?:\\$\\d+|\\d{1,3}\\s?(?:%|percent))",
      "flags": "i"
    },
    {
      "source": "\\bno charge\\b|\\bon the house\\b|\\bcomplimentary\\b",
      "flags": "i"
    },
    {
      "source": "\\bhalf[\\s-](?:price|off)\\b",
      "flags": "i"
    },
    {
      "source": "\\bbuy\\s+one,?\\s+get\\s+one\\b|\\bbogo\\b",
      "flags": "i"
    },
    {
      "source": "\\b(?:is|are|it's|it’s|for|totally|completely|absolutely)\\s+free\\b(?![\\w-])(?!\\s+(?:to|up|from)\\b)",
      "flags": "i"
    },
    {
      "source": "(?<!\\b(?:count|counting|counted|rely|relying|relied|depend|depending|depended|call|calling|called|lean|leaning|bet|trust|trusting|eye|eyes)\\s+)\\bon\\s+us\\b(?!\\s+to\\b)",
      "flags": "i"
    },
    {
      "source": "\\bwaiv(?:e|es|ed|er|ers|ing)\\b",
      "flags": "i"
    },
    {
      "source": "\\bno\\s+(?:extra\\s+|additional\\s+)?costs?\\b|\\bno\\s+(?:extra|additional)\\s+charges?\\b",
      "flags": "i"
    }
  ],
  "social_proof_patterns": [
    {
      "source": "\\b(?:one of our (?:customers|clients)|a recent (?:customer|client))\\b[^.!?]*\\b(?:said|told us|raved|loved)\\b",
      "flags": "i"
    },
    {
      "source": "[\"“][^\"”]{20,}[\"”]\\s*[-—]\\s*(?:a\\s)?(?:happy|satisfied|local)\\s+(?:customer|client)",
      "flags": "i"
    },
    {
      "source": "\\b5[- ]star (?:review|rating)s? (?:from|say)\\b",
      "flags": "i"
    }
  ],
  "hold_keywords": [
    "complaint",
    "complain",
    "refund",
    "money back",
    "chargeback",
    "lawyer",
    "attorney",
    "solicitor",
    "legal action",
