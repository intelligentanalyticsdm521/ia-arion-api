    {
      "job_key": "arion.blog_posts",
      "def": {
        "schema": "agent-job/1",
        "job": "arion.blog_posts",
        "name": "Blog posts",
        "trigger": {
          "type": "schedule",
          "every": "week",
          "day": "mon"
        },
        "reads": [
          "brief.services",
          "brief.servicesSummary",
          "brief.serviceArea",
          "brief.brandVoice",
          "brief.doNotSay",
          "brief.noGoList",
