              "no_price",
              "offers_from_brief_only",
              "no_invented_proof",
              "no_names_from_never_name",
              "no_competitor_names",
              "no_ranking_promise"
            ],
            "words": "Checks it against what I never do"
          },
          {
            "id": "publish_blog_post",
            "action": "arion.publish_blog_post",
            "words": "Puts it on your website",
            "hold": "by_mode"
          }
        ],
        "vars": {
          "posts_per_week": {
            "label": "Posts a week",
            "type": "int",
            "default": 1,
            "min": 1,
            "max": 3
          },
          "seed_topics": {
            "label": "Topics to lean towards",
            "type": "list",
            "default": [],
            "max_items": 10,
            "max_len": 80
          }
        }
      },
      "checksum": "3020d501f6da7ba2ece9560756dab1b693723107ba0599273a8da747dbb62e6c"
    },
    {
