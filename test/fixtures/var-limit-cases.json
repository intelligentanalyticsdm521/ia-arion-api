        "label": "Posts a week",
        "min": 1,
        "max": 3,
        "default": 1
      },
      "value": 2,
      "ok": true
    },
    {
      "why": "an int above its highest",
      "spec": {
        "type": "int",
        "label": "Posts a week",
        "min": 1,
        "max": 3,
        "default": 1
      },
      "value": 4,
      "ok": false
    },
    {
